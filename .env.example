# Optional: email alerts (circuit breaker / completion). Leave unset to skip.
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
# NOTIFY_TO=
# NOTIFY_FROM=

# Live catalog HTTP (optional — private use only; comply with vendor terms)

# When unset or CATALOG_HTTP_ENABLED=0, the pipeline stays in offline mode (bundled sample JSON; default path data/sample/offline_vendor.json, overridable in config.yaml).
#
# CATALOG_HTTP_ENABLED=1
# CATALOG_SEARCH_URL_PODCAST_TEMPLATE=https://example.invalid/find?q={query}&s=tt&ttype=podcast_series
# CATALOG_SEARCH_URL_FALLBACK_TEMPLATE=https://example.invalid/find?q={query}&s=tt
# CATALOG_TITLE_PAGE_URL_TEMPLATE=https://example.invalid/title/{catalog_show_id}/
# CATALOG_GRAPHQL_HTTP_URL=https://example.invalid/graphql
# CATALOG_HTTP_ORIGIN_HEADER=https://example.invalid
# CATALOG_HTTP_REFERER_HEADER=https://example.invalid/
# CATALOG_GRAPHQL_OPERATION_NAME=TitleEpisodesSubPagePagination
# CATALOG_GRAPHQL_PERSISTED_HASH=
# CATALOG_GRAPHQL_VARIABLES_RETURN_URL=https://example.invalid/close_me
